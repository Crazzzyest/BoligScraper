# ========================================
# Google API Configuration (REQUIRED)
# ========================================
# Get your key from: https://console.cloud.google.com/
# 
# Steps to get API key:
# 1. Create a new project (or select existing)
# 2. Enable these APIs:
#    - Distance Matrix API
#    - Maps JavaScript API
# 3. Go to "Credentials" → "Create Credentials" → "API Key"
# 4. Copy and paste your key below:

GOOGLE_API_KEY=your_api_key_here

# ========================================
# Server Configuration
# ========================================
# Port the web server will run on (default: 3000)
PORT=3000

# ========================================
# Crawler Settings
# ========================================
# Run browser in headless mode (true = no visible browser window)
PLAYWRIGHT_HEADLESS=true

# Maximum number of listings to crawl per search (default: 20)
# Higher number = longer wait time
MAX_LISTINGS=20
